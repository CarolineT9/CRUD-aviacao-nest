generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Piloto {
  id          Int           @id @default(autoincrement())
  nome        String
  matricula   String        @unique
  isAtivo     Boolean       @default(true)

  planosDeVoo PlanoDeVoo[]
}

model Aerovia {
  id            Int           @id @default(autoincrement())
  origem        String
  destino       String
  tamanho       Int

  planosDeVoo   PlanoDeVoo[]
}

model PlanoDeVoo {
  id          Int       @id @default(autoincrement())

  pilotoId    Int
  piloto      Piloto    @relation(fields: [pilotoId], references: [id])

  aeroviaId   Int
  aerovia     Aerovia   @relation(fields: [aeroviaId], references: [id])

  data        DateTime
  horario     String
  altitude    Int
  slots       Json
  cancelado   Boolean   @default(false)
}