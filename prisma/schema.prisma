generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Piloto {
  id          Int           @id @default(autoincrement())
  nome        String
  matricula   String        @unique
  isAtivo     Boolean       @default(true)

  planosDeVoo PlanoDeVoo[]
}

model Aerovia {
  id            Int           @id @default(autoincrement())
  origem        String
  destino       String
  tamanho       Int

  planosDeVoo   PlanoDeVoo[]
}

model PlanoDeVoo {
  id          Int       @id @default(autoincrement())

  pilotoId    Int
  piloto      Piloto    @relation(fields: [pilotoId], references: [id])

  aeroviaId   Int
  aerovia     Aerovia   @relation(fields: [aeroviaId], references: [id])

  data        DateTime
  horario     String
  altitude    Int
  slots       Json
  cancelado   Boolean   @default(false)
}

model Aeronave {
  id                 Int    @id @default(autoincrement())
  prefixo            String @unique
  tipo               TipoAeronave
  velocidadeCruzeiro Int
  autonomia          Int

  particular         AeronaveParticular?
  comercial          AeronaveComercial?
}

model AeronaveParticular {
  id              Int @id @default(autoincrement())

  aeronaveId      Int @unique
  aeronave        Aeronave @relation(fields: [aeronaveId], references: [id])

  respManutencao  String
}

model AeronaveComercial {
  id             Int @id @default(autoincrement())

  aeronaveId     Int @unique
  aeronave       Aeronave @relation(fields: [aeronaveId], references: [id])

  nomeCia        String

  passageiro     AeronavePassageiro?
  carga          AeronaveCarga?
}

model AeronavePassageiro {
  id            Int @id @default(autoincrement())

  comercialId   Int @unique
  comercial     AeronaveComercial @relation(fields: [comercialId], references: [id])

  maxPassageiros Int
}

model AeronaveCarga {
  id           Int @id @default(autoincrement())

  comercialId  Int @unique
  comercial    AeronaveComercial @relation(fields: [comercialId], references: [id])

  pesoMax      Float
}

enum TipoAeronave {
  PARTICULAR
  PASSAGEIRO
  CARGA
}